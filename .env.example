# ── ANPR Environment Variables ──────────────────────────
# Copy this file to .env and fill real values. Never commit .env.

# ── Roboflow ──────────────────────────────────────────
ROBOFLOW_API_KEY=your_roboflow_api_key_here
ROBOFLOW_WORKSPACE=objectdetection-twsk1
ROBOFLOW_PROJECT=licenseplate-mswpd-lbgrc
ROBOFLOW_VERSION=1

# ── DagsHub / MLflow ──────────────────────────────────
DAGSHUB_REPO_OWNER=RisAhamed
DAGSHUB_REPO_NAME=ANPR
MLFLOW_TRACKING_URI=https://dagshub.com/RisAhamed/ANPR.mlflow
DAGSHUB_TOKEN=your_dagshub_token_here

# ── App ───────────────────────────────────────────────
ANPR_DEVICE=auto          # auto | cpu | cuda | mps
ANPR_VEHICLE_MODEL=models/vehicle_detection_model/best.pt
ANPR_PLATE_MODEL=models/number_plated/number_plates_model.pt
ANPR_VEHICLE_CONF=0.2
ANPR_PLATE_CONF=0.4
ANPR_OCR_ENGINE=easyocr   # easyocr | keras_ocr | nanonets

# ── Streamlit ─────────────────────────────────────────
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
